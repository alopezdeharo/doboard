<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_surface_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_widget_add_title"
        android:textColor="@color/widget_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/today_widget_add_subtitle"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/today_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_input_bg"
        android:hint="@string/today_widget_hint"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="3"
        android:minHeight="48dp"
        android:padding="14dp"
        android:textColor="@color/widget_on_surface"
        android:textColorHint="@color/widget_on_surface_muted"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_dialog_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_unselected"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="@string/today_widget_cancel"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/today_dialog_btn_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_submit_btn_bg"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="@string/today_widget_add_button"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ── Cabecera ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tap en el título abre la app -->
        <TextView
            android:id="@+id/today_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🐸 Hoy"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/widget_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Mismo tratamiento que el widget Doboard: includeFontPadding=false + gravity=center -->
        <TextView
            android:id="@+id/today_btn_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_btn_bg"
            android:contentDescription="@string/today_widget_add_button"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Lista de tareas ───────────────────────────────────────────────── -->
    <ListView
        android:id="@+id/today_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:visibility="gone" />

    <!-- ── Estado vacío ──────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/today_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/today_widget_empty"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
